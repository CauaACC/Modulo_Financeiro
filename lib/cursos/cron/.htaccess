# Bloqueia acesso direto a qualquer arquivo desta pasta via web.
# Os scripts daqui sao para uso EXCLUSIVO via PHP CLI (cron do servidor),
# nunca devem ser servidos pelo Apache — cada script tambem tem sua propria
# checagem php_sapi_name()==='cli', isto e so camada extra (defense in depth).

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Belt and suspenders: nega tambem se algum outro vhost reabilitar acesso
<FilesMatch "\.(php|json|lock|md|txt|xml|yml|yaml|dist|sample)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
